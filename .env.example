# ===== 慢慢 配置文件 =====
# 复制为 .env 后修改：cp .env.example .env

# --- LLM（OpenAI 兼容接口，必填） ---
# baseURL 需要带版本路径，例如 OpenAI 官方为 https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxx

# 默认选中的模型（可留空，留空则默认选模型列表第一个）
DEFAULT_MODEL=

# --- 登录账号密码 ---
AUTH_USERNAME=admin
AUTH_PASSWORD=manman123

# --- 会话签名密钥（建议改成一段随机字符串；不设置则每次重启后需重新登录） ---
SESSION_SECRET=

# --- 网站端口（宿主机） ---
PORT=8080
